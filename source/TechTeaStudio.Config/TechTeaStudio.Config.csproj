<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>TechTeaStudio.Config</PackageId>
		<Version>0.1.7</Version>
		<Authors>Ronald Ryan</Authors>
		<Company>Tech Tea Studio</Company>
		<Description>Core configuration file handler supporting JSON, INI, XML, and YAML formats.</Description>
		<RepositoryUrl>https://github.com/TechTeaStudio/ConfigBase</RepositoryUrl>
		<PackageIcon>BaseIcon.png</PackageIcon>
		<PackageTags>config json TechTeaStudio</PackageTags>
		<Copyright>Copyright © Tech Tea Studio 2025</Copyright>

		<PackageReleaseNotes>
			v0.1.7: Unified MIT license expression across all packages; updated package description; removed dead async helper method.
		</PackageReleaseNotes>
	</PropertyGroup>

	<PropertyGroup>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\BaseIcon.png" Pack="true" PackagePath="\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
